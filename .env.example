# Template only — keep real values in .env.local (git-ignored) and in your hosting
# provider's environment settings (e.g. Vercel → Settings → Environment Variables).
# Never put real values in this file: it IS committed.

# Upstash Redis — from console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email-code login for /admin
# The only address that can receive login codes
ADMIN_EMAIL=
# From resend.com → API Keys
RESEND_API_KEY=
# Optional: sender shown in the email (default: Portfolio Admin <onboarding@resend.dev>)
ADMIN_EMAIL_FROM=
# Random string, at least 32 characters:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_SESSION_SECRET=

# Optional: search engine ownership codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
